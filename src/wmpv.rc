#include "version.h"

#define IDI_ICON1 101
IDI_ICON1 ICON "..\\assets\\icon.ico"

// The version resource MUST have ID 1, otherwise GetFileVersionInfo() and
// Windows Explorer's "Details" tab cannot find it.
1 VERSIONINFO
 FILEVERSION    WMPV_VERSION_RC
 PRODUCTVERSION WMPV_VERSION_RC
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "wmpv contributors"
            VALUE "FileDescription",  WMPV_FILE_DESC
            VALUE "FileVersion",      WMPV_VERSION
            VALUE "InternalName",     WMPV_PRODUCT_NAME
            VALUE "LegalCopyright",   WMPV_COPYRIGHT
            VALUE "OriginalFilename", "wmpv.exe"
            VALUE "ProductName",      WMPV_PRODUCT_NAME
            VALUE "ProductVersion",   WMPV_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
